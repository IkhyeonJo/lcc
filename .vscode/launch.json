{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LCC: Debug CPP (C -> preprocessed C)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-ubuntu24/lcc-build/cpp",
      "args": [
        "-I${workspaceFolder}/build-ubuntu24/lcc-build/include",
        "${workspaceFolder}/hello.c",
        "${workspaceFolder}/hello.i"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "LCC: Debug RCC (preprocessed C -> AT&T assembly)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-ubuntu24/lcc-build/rcc",
      "args": [
        "-target=x86/linux",
        "-g",
        "${workspaceFolder}/hello.i",
        "${workspaceFolder}/hello.s"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "LCC: Debug RCC (preprocessed C -> NASM assembly)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-ubuntu24/lcc-build/rcc",
      "args": [
        "-target=x86/nasm",
        "-g",
        "${workspaceFolder}/hello.i",
        "${workspaceFolder}/hello.nasm.s"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}
